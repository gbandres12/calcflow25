# Supabase (obrigatório em produção)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Servidor / webhook (não exponha no frontend)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# API fiscal (somente server)
NOTAAS_API_KEY=
NOTAAS_WEBHOOK_SECRET=

# Agente financeiro no Telegram (somente server)
# Token do BotFather. Nunca comitar.
TELEGRAM_BOT_TOKEN=
# Segredo conferido no header X-Telegram-Bot-Api-Secret-Token. Invente uma frase longa.
TELEGRAM_WEBHOOK_SECRET=
# Username do bot, sem @, usado no link t.me do card de pareamento.
TELEGRAM_BOT_USERNAME=
# Só "true" libera lançamento pelo chat. Suba como consulta primeiro.
TELEGRAM_AGENT_WRITES=false
# Chave do Gemini usada pelo agente no servidor.
GEMINI_API_KEY=

# TestSprite MCP (não commitar a chave). O servidor MCP lê a variável API_KEY.
# No Cursor, mapeie TESTSPRITE_API_KEY → env.API_KEY em .cursor/mcp.json.
TESTSPRITE_API_KEY=
